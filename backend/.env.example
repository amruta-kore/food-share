# Database connection string (e.g. Aiven, Railway, PlanetScale, or Render MySQL)
DATABASE_URL="mysql://user:password@host:3306/foodshare"

# Secret keys for signing JWT tokens
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-refresh-jwt-secret"

# Email Configuration (Gmail App Password)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"

# Server Port (Auto-assigned by Render/Railway)
PORT=4000
